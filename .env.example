# ==============================================================
#  PROJECT ENV
#  Setup:  cp .env.example .env.local && bun run setup
#  `bun run setup` fills in the three secrets below automatically.
#  Then substitute the values marked  <-- FILL IN
# ==============================================================


# ─── 1. DATABASE (required) ───────────────────────────────────
#
# MongoDB Atlas:  Cluster → Connect → Drivers → copy the string.
#
# ⚠️  Atlas gives you a string with NO database name:
#       mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
#                                                  ↑ empty
#     Pasted as-is, every collection silently lands in a database
#     called `test`. Add your db name before the `?`:
#       mongodb+srv://user:pass@cluster.mongodb.net/myproject?retryWrites=true
#
#     Boot will refuse to start if the name is missing.
#
# ⚠️  Deploying: add your server's IP to Atlas → Network Access,
#     or the connection hangs with an unhelpful error.
#
# Local Docker instead:  docker compose up -d
#   → mongodb://127.0.0.1/myproject
#   Note: local Docker Mongo is standalone, so Payload transactions
#   are OFF locally but ON with Atlas. See README.
#
DATABASE_URL=                                    # <-- FILL IN


# ─── 2. SECRETS (required — `bun run setup` generates these) ──
PAYLOAD_SECRET=
CRON_SECRET=
PREVIEW_SECRET=

# ─── 2b. PASSKEYS / WebAuthn (optional; defaults to localhost) ─
#
# Passkeys are cryptographically bound to an ORIGIN and a Relying Party ID.
# Get this wrong and the browser silently refuses the ceremony.
#
# Set the FULL origin(s) this app is served from. The first one is
# canonical — its hostname becomes the rpID that credentials are scoped to.
# Comma-separate to accept more than one (e.g. bare + www):
#
#   APP_ORIGIN=https://internal.allwesternmortgage.com
#   APP_ORIGIN=https://internal.example.com,https://www.internal.example.com
#
# ⚠️  Changing the FIRST entry's hostname invalidates every existing
#     passkey — they are scoped to the old rpID and cannot be migrated.
#     Users would have to enrol again.
#
# Leave unset for local development (defaults to http://localhost:3000,
# rpID "localhost", which browsers permit over plain http).
APP_ORIGIN=


# ─── 3. SITE IDENTITY (required) ──────────────────────────────
#
# NEXT_PUBLIC_SERVER_URL — no trailing slash. Drives CORS, OG tags,
# sitemaps, canonical URLs. Set to the real domain in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Appended to every page title: "About | <SITE NAME>"
NEXT_PUBLIC_SITE_NAME=                           # <-- FILL IN


# ─── 4. EMAIL / RESEND (optional) ─────────────────────────────
#
# Required for contact-form notifications and admin password
# resets. Without RESEND_API_KEY, Payload logs emails to the
# console instead of sending them — fine for local dev.
#
# Key: resend.com → API Keys. The from-address domain must be
# verified in Resend first, or sends fail.
#
RESEND_API_KEY=                                  # <-- FILL IN
RESEND_FROM_ADDRESS=noreply@yourdomain.com       # <-- FILL IN
RESEND_FROM_NAME=                                # <-- FILL IN


# ─── 5. ANALYTICS & PIXELS (all optional) ─────────────────────
#
# Each one is inert when left blank — no script is injected.
#
# ⚠️  These are NEXT_PUBLIC_*, so they are baked in at BUILD time,
#     not read at runtime. On Coolify you must mark them as
#     "Build Variable", not just runtime, or they resolve to empty.
#     Changing any of them requires a rebuild, not a restart.
#
# Google Analytics 4 — format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Tag Manager — format: GTM-XXXXXXX
# If you route GA through GTM, set GTM only and leave GA blank.
NEXT_PUBLIC_GTM_ID=

# Meta / Facebook Pixel — numeric ID from Events Manager
NEXT_PUBLIC_FB_PIXEL_ID=


# ─── 6. MEDIA STORAGE ─────────────────────────────────────────
#
# local → files in public/media (simplest)
#         ⚠️  On Coolify this is INSIDE the container and is wiped
#             on every redeploy. Mount a volume, or use r2.
# r2    → Cloudflare R2 (recommended for production)
#
STORAGE_MODE=local


# ─── 7. CLOUDFLARE R2 (required only when STORAGE_MODE=r2) ────
#
# Setup:
#   1. Cloudflare → R2 → create bucket
#   2. Bucket → Settings → enable Public Access; copy the public URL
#   3. R2 → Manage API tokens → token with Object Read & Write
#   4. Bucket CORS: allow PUT, POST, GET from NEXT_PUBLIC_SERVER_URL
#
# NEXT_PUBLIC_R2_PUBLIC_URL is optional — set it to serve images
# straight from R2's CDN. Unset means Payload proxies them (slower).
#
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# NEXT_PUBLIC_R2_PUBLIC_URL=


# ─── 8. SHOPIFY (optional — headless catalog & cart) ──────────
#
# Leave blank and the storefront helpers return empty results, so
# nothing breaks on projects that don't sell anything.
#
# Use a STOREFRONT API token, NOT an Admin API token. The Admin API
# carries write scopes for orders and inventory; the Storefront API is
# read-only over the catalog plus cart, which is all a website needs.
#
# Setup:
#   1. Shopify admin → Settings → Apps and sales channels
#   2. Develop apps → Create an app
#   3. Configure Storefront API scopes:
#        unauthenticated_read_product_listings
#        unauthenticated_read_product_inventory
#        unauthenticated_write_checkouts
#        unauthenticated_read_checkouts
#   4. Install app → reveal the Storefront API access token
#
# ⚠️  NOT prefixed NEXT_PUBLIC_ on purpose. The token stays server-side,
#     so it never lands in the browser bundle — which also means it is a
#     plain RUNTIME variable on Coolify, with no Dockerfile ARG needed.
#     Never add the prefix to it.
#
# Domain accepts any of: acme / acme.myshopify.com / https://acme.myshopify.com
#
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
#
# Optional — pins the dated API version. Shopify ships one each quarter
# and supports it for a year. Defaults to 2026-07.
# SHOPIFY_API_VERSION=2026-07
